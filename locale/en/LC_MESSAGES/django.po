msgstr "Members sharing this expense"

msgid "例如：晚餐"
msgstr "For example: dinner"

msgid "至少選擇一位參與成員。"
msgstr "Select at least one member to share this expense."

msgid "金額必須大於 0。"
msgstr "Amount must be greater than zero."

msgid "平均分攤"
msgstr "Equal split"

